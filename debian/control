# Upstream publishes prebuilt Electron and Node runtimes for x64, arm64 and
# armv7l only; there is no riscv64 Electron, so the build cannot run there.
Architecture: amd64 arm64 armhf
# The Electron runtime is a prebuilt vendor bundle which we ship as-is, so
# dh_shlibdeps does not run over it (see debian/rules): its dependencies are
# listed explicitly instead of coming from ${shlibs:Depends}.
